# Copy this file to .env and fill in your values.

# --- Apibara (PRIMARY discovery: real Copart + IAAI) ------------------------
# Key at https://apibara.tech (Test plan: 100 req/mo, 1 req/sec).
APIBARA_API_KEY=
# 24h polling ≈ 30 calls/mo per search. APIBARA_MAX_PAGES=1 = one 20-lot page/poll.
POLL_INTERVAL_HOURS=24
APIBARA_MAX_PAGES=1

# --- API Auctions (ALTERNATIVE discovery: Copart + IAAI + Emirates) ---------
# Token at https://apiauctions.io/register (Free demo: 10 req/HOUR, card on
# file but $0 charged). Sent as "Authorization: Bearer <token>".
# Used only by analytics/scripts/pull_apiauctions_01.py — the app itself does
# not read this.
APIAUCTIONS_API_TOKEN=

# --- MarketCheck (pricing: clean-value comps + VIN history) -----------------
# Key at https://developers.marketcheck.com (free plan: 500 calls/mo).
MARKETCHECK_API_KEY=

# --- Email alerts (optional) ------------------------------------------------
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your gmail,
# SMTP_PASS=an "App password" (Google Account -> Security -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=klubko04@gmail.com
ALERT_EMAIL_FROM=

# --- Legacy demo lookup (used only when MarketCheck key is empty) ------------
AUCTION_API_PROVIDER=demo
